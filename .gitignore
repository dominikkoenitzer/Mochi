# Build output
/target
/dist

# Logs and crash dumps: the daemon writes mochi.log, a test run can drop one
# next to the checkout.
*.log
*.dmp
*.pdb

# Config and schema copies produced by a manual session, an install run or a
# test. The real config lives in %USERPROFILE%, never in the repository.
mochi.json
mochi-*.json
mochi.schema.json
whkdrc

# Release artefacts built by hand rather than by the workflow
*.zip
*.zip.sha256

# Editors and tooling
.vs/
.idea/
*.user
*.suo
